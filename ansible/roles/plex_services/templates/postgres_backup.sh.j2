#!/bin/bash
#
# PostgreSQL Backup Script for Plex Services
# Backs up PostgreSQL databases to local and remote (SMB) storage
#
set -euo pipefail

# Configuration
BACKUP_DIR="/opt/plex-services/postgres_backups"
RETENTION_DAYS="{{ postgres_backup_retention_days | default('30') }}"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
LOG_FILE="/var/log/postgres_backup.log"

POSTGRES_PASSWORD="$(grep -m1 '^postgres_password=' /etc/infisical/secrets/plex-services.env 2>/dev/null | cut -d= -f2- || true)"

# PostgreSQL connection details
POSTGRES_USER="{{ postgres_user | default('qstick') }}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-{{ secrets.plex_services.postgres_password }}}"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# SMB Configuration
{% if plex_backup_smb_server is defined and postgres_backup_enabled | default(true) %}
SMB_SERVER="{{ plex_backup_smb_server }}"
SMB_SHARE="{{ plex_backup_smb_share }}"
SMB_USER="{{ plex_backup_smb_user }}"
SMB_PASS="${PLEX_SMB_PASS:-{{ plex_backup_smb_pass }}}"
SMB_DOMAIN="{{ plex_backup_smb_domain | default('') }}"
REMOTE_BACKUP_PATH="{{ postgres_backup_remote_path | default('plex_services/postgres_backups') }}"
SMB_ENABLED=true
{% else %}
SMB_ENABLED=false
{% endif %}

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOG_FILE"
}

error_exit() {
    log "ERROR: $1"
    exit 1
}

mkdir -p "$BACKUP_DIR"

log "Starting PostgreSQL backup process"

log "Backing up global objects (roles, tablespaces, etc.)"
GLOBALS_FILE="$BACKUP_DIR/postgres_globals_${TIMESTAMP}.sql"
if PGPASSWORD="$POSTGRES_PASSWORD" pg_dumpall -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" -U "$POSTGRES_USER" --globals-only > "$GLOBALS_FILE"; then
    gzip "$GLOBALS_FILE"
    log "Successfully created globals backup: ${GLOBALS_FILE}.gz"

    if [ "$SMB_ENABLED" = true ]; then
        if [ -n "$SMB_DOMAIN" ]; then
            smbclient "//$SMB_SERVER/$SMB_SHARE" -U "$SMB_DOMAIN/$SMB_USER%$SMB_PASS" -c "mkdir \"$REMOTE_BACKUP_PATH\" 2>/dev/null; cd \"$REMOTE_BACKUP_PATH\"; put \"${GLOBALS_FILE}.gz\" \"$(basename "${GLOBALS_FILE}.gz")\"" 2>/dev/null || log "WARNING: Failed to upload globals backup to SMB share"
        else
            smbclient "//$SMB_SERVER/$SMB_SHARE" -U "$SMB_USER%$SMB_PASS" -c "mkdir \"$REMOTE_BACKUP_PATH\" 2>/dev/null; cd \"$REMOTE_BACKUP_PATH\"; put \"${GLOBALS_FILE}.gz\" \"$(basename "${GLOBALS_FILE}.gz")\"" 2>/dev/null || log "WARNING: Failed to upload globals backup to SMB share"
        fi
    fi
else
    rm -f "$GLOBALS_FILE"
    error_exit "Failed to backup global objects"
fi

DATABASES=$(PGPASSWORD="$POSTGRES_PASSWORD" psql -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" -U "$POSTGRES_USER" -d "{{ postgres_default_db | default('radarr-main') }}" -t -c "SELECT datname FROM pg_database WHERE datistemplate = false AND datname NOT IN ('postgres', 'template0', 'template1');" | grep -v '^$' | tr -d ' ')

if [ -z "$DATABASES" ]; then
    log "No user databases found to backup"
    exit 0
fi

for DB in $DATABASES; do
    log "Backing up database: $DB"
    BACKUP_FILE="$BACKUP_DIR/${DB}_${TIMESTAMP}.dump"

    # Create compressed backup in custom format (better for pg_restore)
    if PGPASSWORD="$POSTGRES_PASSWORD" pg_dump -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" -U "$POSTGRES_USER" -Fc -f "$BACKUP_FILE" "$DB"; then
        log "Successfully created backup: $BACKUP_FILE"

        if [ "$SMB_ENABLED" = true ]; then
            log "Uploading backup to SMB share: $SMB_SERVER/$SMB_SHARE/$REMOTE_BACKUP_PATH/"

            if [ -n "$SMB_DOMAIN" ]; then
                smbclient "//$SMB_SERVER/$SMB_SHARE" -U "$SMB_DOMAIN/$SMB_USER%$SMB_PASS" -c "mkdir \"$REMOTE_BACKUP_PATH\" 2>/dev/null; exit" 2>/dev/null || true
            else
                smbclient "//$SMB_SERVER/$SMB_SHARE" -U "$SMB_USER%$SMB_PASS" -c "mkdir \"$REMOTE_BACKUP_PATH\" 2>/dev/null; exit" 2>/dev/null || true
            fi

            SMB_PUT_OK=true
            if [ -n "$SMB_DOMAIN" ]; then
                smbclient "//$SMB_SERVER/$SMB_SHARE" -U "$SMB_DOMAIN/$SMB_USER%$SMB_PASS" -c "cd \"$REMOTE_BACKUP_PATH\"; put \"$BACKUP_FILE\" \"$(basename "$BACKUP_FILE")\"" || SMB_PUT_OK=false
            else
                smbclient "//$SMB_SERVER/$SMB_SHARE" -U "$SMB_USER%$SMB_PASS" -c "cd \"$REMOTE_BACKUP_PATH\"; put \"$BACKUP_FILE\" \"$(basename "$BACKUP_FILE")\"" || SMB_PUT_OK=false
            fi

            if [ "$SMB_PUT_OK" = true ]; then
                log "Successfully uploaded backup to SMB share"
            else
                log "WARNING: Failed to upload backup to SMB share"
            fi
        fi
    else
        error_exit "Failed to create backup for database: $DB"
    fi
done

log "Cleaning up local backups older than $RETENTION_DAYS days"
find "$BACKUP_DIR" -name "*.dump" -type f -mtime +$RETENTION_DAYS -delete
find "$BACKUP_DIR" -name "*.sql.gz" -type f -mtime +$RETENTION_DAYS -delete

if [ "$SMB_ENABLED" = true ]; then
    log "Cleaning up remote backups older than $RETENTION_DAYS days"

    CUTOFF_DATE=$(date -d "$RETENTION_DAYS days ago" +%Y%m%d)

    if [ -n "$SMB_DOMAIN" ]; then
        REMOTE_FILES=$(smbclient "//$SMB_SERVER/$SMB_SHARE" -U "$SMB_DOMAIN/$SMB_USER%$SMB_PASS" -c "cd \"$REMOTE_BACKUP_PATH\"; ls" 2>/dev/null | grep -E "\.(dump|sql\.gz)$" | awk '{print $1}' || true)
    else
        REMOTE_FILES=$(smbclient "//$SMB_SERVER/$SMB_SHARE" -U "$SMB_USER%$SMB_PASS" -c "cd \"$REMOTE_BACKUP_PATH\"; ls" 2>/dev/null | grep -E "\.(dump|sql\.gz)$" | awk '{print $1}' || true)
    fi

    for FILE in $REMOTE_FILES; do
        # Extract date from filename (assuming format: dbname_YYYYMMDD_HHMMSS.sql.gz)
        FILE_DATE=$(echo "$FILE" | grep -o '[0-9]\{8\}_[0-9]\{6\}' | cut -d'_' -f1 || true)

        if [ -n "$FILE_DATE" ] && [ "$FILE_DATE" -lt "$CUTOFF_DATE" ]; then
            log "Deleting old remote backup: $FILE"
            if [ -n "$SMB_DOMAIN" ]; then
                smbclient "//$SMB_SERVER/$SMB_SHARE" -U "$SMB_DOMAIN/$SMB_USER%$SMB_PASS" -c "cd \"$REMOTE_BACKUP_PATH\"; del \"$FILE\"" 2>/dev/null || log "WARNING: Failed to delete remote file: $FILE"
            else
                smbclient "//$SMB_SERVER/$SMB_SHARE" -U "$SMB_USER%$SMB_PASS" -c "cd \"$REMOTE_BACKUP_PATH\"; del \"$FILE\"" 2>/dev/null || log "WARNING: Failed to delete remote file: $FILE"
            fi
        fi
    done
fi

log "PostgreSQL backup process completed successfully"
