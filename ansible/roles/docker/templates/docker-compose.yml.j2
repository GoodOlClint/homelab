services:
  kiwix:
    image: ghcr.io/kiwix/kiwix-serve:latest
    container_name: kiwix
    restart: unless-stopped
    ports:
      - 8090:8080
    environment:
      - TZ={{ timezone }}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ docker_kiwix_dir }}:/data:ro
    command:
      - '*.zim'
  valheim:
    container_name: valheim
{# Upstream for now: the PlayFab-aware status.json/healthcheck lives in the local fork #}
{# (~/Source/valheim-server-docker) — open a PR upstream, then restore the healthcheck. #}
    image: ghcr.io/community-valheim-tools/valheim-server:latest
    restart: unless-stopped
{# The server only writes the world on a clean SIGINT (ZNet.Shutdown -> Save(sync:true)). #}
{# Docker's default 10s stop timeout SIGKILLs mid-save; the image's own shutdown waits 29s #}
{# before escalating and supervisord allows 90s, so give it room. #}
    stop_grace_period: 120s
    cap_add:
      - sys_nice
    ports:
      - "2456-2458:2456-2458/udp"
      - "8080:80/tcp"
{# ponytail: host 9002 — container 9001 is supervisor's default, but host 9001 belongs to portainer-agent #}
      - "{{ valheim_supervisor_port }}:9001/tcp"
    env_file:
      - /etc/infisical/secrets/docker-valheim.env
    environment:
      - TZ={{ timezone }}
      - SUPERVISOR_HTTP=true
      - SUPERVISOR_HTTP_USER={{ valheim_supervisor_user }}
      - STATUS_HTTP=true
      - SERVER_NAME={{ valheim_server_name }}
      - WORLD_NAME={{ valheim_world_name }}
      - SERVER_PUBLIC={{ valheim_server_public | default('false') }}
      - CROSSPLAY={{ valheim_crossplay | default('true') }}
      - SERVER_ARGS={{ valheim_server_args | default('') }}
{# The join code rotates on every restart (nightly UPDATE_CRON, any redeploy), so it #}
{# gets posted by the image's own log-filter hook. $$ escapes compose interpolation — #}
{# these must expand in the container's shell, not on the Ansible host. #}
      - VALHEIM_LOG_FILTER_CONTAINS_JoinCode=registered with join code
      - 'ON_VALHEIM_LOG_FILTER_CONTAINS_JoinCode={ read l; [ -n "$$DISCORD_WEBHOOK" ] || exit 0; curl -sfSL -X POST -H "Content-Type: application/json" -d "{\"content\":\"Valheim is up - join code **$${l##*join code }**\"}" "$$DISCORD_WEBHOOK"; }'
      - BACKUPS_ENABLED=true
      - BACKUPS_CRON=0 */6 * * *
      - BACKUPS_MAX_COUNT=10
      - UPDATE_CRON=0 4 * * *
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ docker_base_dir }}/valheim/config:/config
      - {{ docker_base_dir }}/valheim/data:/opt/valheim
{# Restarts any container marked unhealthy that carries the autoheal=true label. #}
{# Gives the Valheim PlayFab zombie an auto-recovery path Docker's restart policy lacks #}
{# (restart: unless-stopped never fires on an unhealthy-but-running container). #}
  autoheal:
    container_name: autoheal
    image: willfarrell/autoheal:latest
    restart: unless-stopped
    environment:
      - TZ={{ timezone }}
      - AUTOHEAL_CONTAINER_LABEL=autoheal
      - AUTOHEAL_INTERVAL=30
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
