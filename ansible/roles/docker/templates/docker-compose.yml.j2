      - tautulli_config:/config
      - plex_media:/data
  cloudflared:
    image: cloudflare/cloudflared:latest
    restart: unless-stopped
    command: >-
      tunnel --no-autoupdate run --token
      ${CLOUDFLARED_TUNNEL_TOKEN}
  readarr:
    container_name: readarr
    image: hotio/readarr:latest
    restart: unless-stopped
    ports:
      - "8787:8787"
    environment:
      - PUID=2007
      - PGID=988
      - UMASK=002
      - TZ=America/Chicago
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - readarr_config:/config
      - plex_media:/data
  lidarr:
    container_name: lidarr
    image: hotio/lidarr:latest
    restart: unless-stopped
    ports:
      - "8686:8686"
    environment:
      - PUID=2008
      - PGID=988
      - TZ=America/Chicago
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - lidarr_config:/config
      - plex_media:/data
  sabnzbd:
    container_name: sabnzbd
    image: hotio/sabnzbd:latest
    restart: unless-stopped
    logging:
      driver: json-file
    ports:
      - "8080:8080"
    environment:
      - PUID=2003
      - PGID=988
      - UMASK=002
      - TZ=America/Chicago
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - sabnzbd_config:/config
      - plex_media:/data:rw
  plex-meta-manager:
    container_name: plex-meta-manager
    image: meisnate12/plex-meta-manager:latest
    restart: unless-stopped
    environment:
      - PUID=1000
      - PGID=988
      - TZ=America/Chicago
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - plex-meta-manager_config:/config:rw
  ombi:
    image: linuxserver/ombi:latest
    container_name: ombi
    restart: unless-stopped
    logging:
      driver: json-file
    depends_on:
      - ombi-mariadb
    environment:
      - PUID=1000
      - PGID=988
      - TZ=America/Chicago
    volumes:
      - ombi_config:/config
    ports:
      - 3579:3579
  ombi-mariadb:
    image: mariadb:latest
    container_name: ombi-mariadb
    restart: unless-stopped
    logging:
      driver: json-file
    environment:
      - "MARIADB_USER=ombi"
      - "MARIADB_PASSWORD=ombi"
      - "MARIADB_DATABASE=ombi"
      - "MARIADB_RANDOM_ROOT_PASSWORD=yes"
      - TZ=America/Chicago
    volumes:
      - "/docker/appdata/ombi-mariadb:/var/lib/mysql"
    ports:
      - 3306:3306
#}
  kiwix:
    image: ghcr.io/kiwix/kiwix-serve:latest
    container_name: kiwix
    restart: unless-stopped
    ports:
      - 8090:8080
    environment:
      - TZ={{ kiwix_timezone }}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - kiwix_config:/data
    command:
      - '*.zim'
  boinc:
    image: linuxserver/boinc:latest
    container_name: boinc
    runtime: nvidia
    restart: unless-stopped
    ports:
      - 7080:8080
      - 7081:8181
      - 31416:31416
    security_opt:
      - seccomp:unconfined #optional
    environment:
      - NVIDIA_VISIBLE_DEVICES=all
      - NVIDIA_DRIVER_CAPABILITIES=all
      - PUID={{ boinc_user }}
      - PGID={{ boinc_group }}
      - TZ={{ boinc_timezone }}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - boinc_config:/config
  doge-node:
    container_name: doge-node
    image: goodolclint/dogecoin-node:latest
    restart: unless-stopped
    ports:
      - 22555:22555
      - 3000:3000
    environment:
      - TZ={{ doge_node_timezone }}
    volumes:
      - doge-node_config:/data
  valheim:
    container_name: valheim
    image: valheim-server:playfab-test
    restart: unless-stopped
{# The server only writes the world on a clean SIGINT (ZNet.Shutdown -> Save(sync:true)). #}
{# Docker's default 10s stop timeout SIGKILLs mid-save; the image's own shutdown waits 29s #}
{# before escalating and supervisord allows 90s, so give it room. #}
    stop_grace_period: 120s
{# The failure this exists for: PlayFab returning ServiceUnavailable at boot — server up, #}
{# no lobby, a zombie nothing external could see. A2S can't see it either (the Steam query #}
{# responder never starts under crossplay). status.json is the direct signal: valheim-status #}
{# rewrites it every 10s and `error` goes non-null the moment the PlayFab query fails. #}
{# The mtime clause catches valheim-status itself dying with a stale-but-valid file. #}
{# Replaced a log-lifecycle grep — same failure, but read from the purpose-built endpoint. #}
{# Every failure mode here is repaired by the container restart autoheal will perform; #}
{# a sustained PlayFab outage will restart-loop, as it would have with the log check. #}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS localhost/status.json | jq -e '.error == null' >/dev/null && [ -n \"$(find /opt/valheim/htdocs/status.json -newermt '-2 minutes')\" ]"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 6m
    cap_add:
      - sys_nice
    ports:
      - "2456-2458:2456-2458/udp"
      - "8080:80/tcp"
{# ponytail: host 9002 — container 9001 is supervisor's default, but host 9001 belongs to portainer-agent #}
      - "{{ valheim_supervisor_port }}:9001/tcp"
    env_file:
      - /etc/infisical/secrets/docker-valheim.env
    environment:
      - TZ={{ timezone }}
      - SUPERVISOR_HTTP=true
      - SUPERVISOR_HTTP_USER={{ valheim_supervisor_user }}
      - STATUS_HTTP=true
      - SERVER_NAME={{ valheim_server_name }}
      - WORLD_NAME={{ valheim_world_name }}
      - SERVER_PUBLIC={{ valheim_server_public | default('false') }}
      - CROSSPLAY={{ valheim_crossplay | default('true') }}
      - SERVER_ARGS={{ valheim_server_args | default('') }}
{# The join code rotates on every restart (nightly UPDATE_CRON, any redeploy), so it #}
{# gets posted by the image's own log-filter hook. $$ escapes compose interpolation — #}
{# these must expand in the container's shell, not on the Ansible host. #}
      - VALHEIM_LOG_FILTER_CONTAINS_JoinCode=registered with join code
      - 'ON_VALHEIM_LOG_FILTER_CONTAINS_JoinCode={ read l; [ -n "$$DISCORD_WEBHOOK" ] || exit 0; curl -sfSL -X POST -H "Content-Type: application/json" -d "{\"content\":\"Valheim is up - join code **$${l##*join code }**\"}" "$$DISCORD_WEBHOOK"; }'
      - BACKUPS_ENABLED=true
      - BACKUPS_CRON=0 */6 * * *
      - BACKUPS_MAX_COUNT=10
      - UPDATE_CRON=0 4 * * *
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - valheim_config:/config
      - valheim_data:/opt/valheim
    labels:
      - autoheal=true
{# autoheal restarts via the API's ?t= param, defaulting to AUTOHEAL_DEFAULT_STOP_TIMEOUT=10 — #}
{# a SIGKILL 10s into a world save, ignoring stop_grace_period. Match it per-container. #}
      - autoheal.stop.timeout=120

{# Restarts any container marked unhealthy that carries the autoheal=true label. #}
{# Gives the Valheim PlayFab zombie an auto-recovery path Docker's restart policy lacks #}
{# (restart: unless-stopped never fires on an unhealthy-but-running container). #}
  autoheal:
    container_name: autoheal
    image: willfarrell/autoheal:latest
    restart: unless-stopped
    environment:
      - TZ={{ timezone }}
      - AUTOHEAL_CONTAINER_LABEL=autoheal
      - AUTOHEAL_INTERVAL=30
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock

