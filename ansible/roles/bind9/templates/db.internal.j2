$TTL    604800
@       IN      SOA     ns.core.{{ network_data.domain_suffix }}. admin.core.{{ network_data.domain_suffix }}. (
                              2         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
@       IN      NS      ns.core.{{ network_data.domain_suffix }}.
ns      IN      A       {{ bind9_ns_ip }}
