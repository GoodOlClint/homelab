
// TSIG key for RFC 2136 updates (Ansible dns_records, external-dns, pfSense)
key "dhcp-update-key" {
    algorithm hmac-sha256;
    secret "{{ secrets.infrastructure.bind_tsig_key_secret }}";
};

// ACME DNS-01 clients (ADR 0050): one key per enrolling host, granted only its own challenge name
{% for h in bind9_acme_hosts %}
key "acme-{{ h }}" {
    algorithm hmac-sha256;
    secret "{{ secrets.infrastructure['acme_tsig_' ~ (h | replace('-', '_'))] }}";
};
{% endfor %}

// CI guest registrations (ADR 0032): granted only in the ci zone below, so a
// leaked runner key can never write the fleet zones
key "ci-update-key" {
    algorithm hmac-sha256;
    secret "{{ secrets.infrastructure.ci_tsig_key_secret }}";
};

{% set secondaries = bind9_instances[1:] | map('extract', hostvars, 'ansible_host') | list %}
{% macro zone(name) %}
zone "{{ name }}" {
{% if name != bind9_ci_zone %}
    // per-zone allow-query replaces the global one: restate internal, minus CI
    allow-query { !{{ bind9_ci_subnet }}; 127.0.0.1; ::1; {{ internal_network_cidr | default(network_data.ipv4_prefix ~ '.0.0/12') }}; };
{% endif %}
{% if bind9_primary %}
    type primary;
    file "/var/lib/bind/db.{{ name }}";
    update-policy {
        grant dhcp-update-key zonesub ANY;
{% if name == service_domain %}
{% for h in bind9_acme_hosts %}
        grant acme-{{ h }} name _acme-challenge.{{ h }}.{{ name }}. TXT;
{% endfor %}
{% for h in bind9_acme_node_hosts %}
        grant acme-{{ h }} name _acme-challenge.{{ bind9_acme_vip_name }}.{{ name }}. TXT;
{% endfor %}
{% endif %}
{% if name == bind9_ci_zone %}
        grant ci-update-key zonesub ANY;
{% endif %}
    };
    // external-dns and the secondaries read the zone by signed AXFR only
    allow-transfer { key "dhcp-update-key"; };
{% if secondaries %}
    also-notify { {{ secondaries | join('; ') }}; };
{% endif %}
{% else %}
    type secondary;
    file "/var/cache/bind/db.{{ name }}";
    primaries { {{ hostvars[bind9_instances[0]].ansible_host }} key "dhcp-update-key"; };
    allow-transfer { key "dhcp-update-key"; };
    // DDNS lands on the VIP, which may sit on a secondary: forward to the primary
    allow-update-forwarding { 127.0.0.1; ::1; {{ internal_network_cidr | default(network_data.ipv4_prefix ~ '.0.0/12') }}; };
{% endif %}
};
{% endmacro %}
// Forward zones — the flat public-domain zones (ADR 0040)
{% for z in bind9_forward_zones %}
{{ zone(z) }}
{% endfor %}

// Reverse zones — PTR records for each VLAN subnet
{% for vlan, z in dns_zones.items() %}
{{ zone(z.vlan_id ~ '.' ~ ipv4_prefix_reversed ~ '.in-addr.arpa') }}
{% endfor %}
