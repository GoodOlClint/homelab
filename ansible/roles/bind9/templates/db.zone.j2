$TTL    {{ zone_ttl | default(300) }}
@       IN      SOA     ns.{{ zone_name }}. admin.{{ zone_name }}. (
                              {{ ansible_facts['date_time']['epoch'] }}         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                            {{ zone_ttl | default(300) }} )       ; Negative Cache TTL (RFC 2308: min of this and the SOA record's own TTL)
;
@       IN      NS      ns.{{ zone_name }}.
ns      IN      A       {{ zone_dns_ip }}
