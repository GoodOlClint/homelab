services:
  infisical:
    image: infisical/infisical:{{ infisical_version }}
    container_name: infisical
    restart: unless-stopped
    ports:
      - "{{ '127.0.0.1:' if bootstrap_config.infisical_url | default('') is match('https://') else '' }}{{ infisical_port }}:8080"
    environment:
      - ENCRYPTION_KEY={{ infisical_encryption_key }}
      - AUTH_SECRET={{ infisical_auth_secret }}
      - DB_CONNECTION_URI=postgres://infisical:{{ infisical_postgres_password | urlencode }}@postgres:5432/infisical
      - REDIS_URL=redis://redis:6379
      - SITE_URL=https://{{ infisical_fqdn }}
      - ACME_DNS_RESOLVER_SERVERS={{ network_data.dns_server.bind_ipv4 }}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8080/api/status"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  caddy:
    image: caddy:latest
    container_name: infisical-caddy
    restart: unless-stopped
    ports:
      - "443:443"
    volumes:
      - {{ infisical_data_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro
      - {{ infisical_tls_dir }}:/tls:ro
    depends_on:
      - infisical

  postgres:
    image: postgres:16-alpine
    container_name: infisical-postgres
    restart: unless-stopped
    environment:
      - POSTGRES_PASSWORD={{ infisical_postgres_password }}
      - POSTGRES_USER=infisical
      - POSTGRES_DB=infisical
    volumes:
      - {{ infisical_data_dir }}/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U infisical"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  redis:
    image: redis:7-alpine
    container_name: infisical-redis
    restart: unless-stopped
    command: --save 60 1 --loglevel warning
    volumes:
      - {{ infisical_data_dir }}/redis:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep PONG"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
