
[[processors.regex]]
  namepass = ["*"]
  [[processors.regex.fields]]
    key = ".*_format$"
    drop = true

# Prometheus client output for scraping
[[outputs.prometheus_client]]
  listen = ":9273"
  metric_version = 2
  string_as_label = true
  export_timestamp = true

{# No outputs.http remote write to OpenObserve — deliberate: Prometheus scrapes
   :9273 instead, because prometheusremotewrite drops string-valued metrics. #}

# System Metrics
[[inputs.cpu]]
  percpu = true
  totalcpu = true
  collect_cpu_time = false
  report_active = false

[[inputs.mem]]

[[inputs.disk]]
  ignore_fs = ["tmpfs", "devtmpfs", "devfs", "overlay", "squashfs"]

[[inputs.diskio]]

[[inputs.net]]
  interfaces = ["eth*", "en*", "wg*"]

[[inputs.netstat]]

[[inputs.system]]

[[inputs.processes]]

[[inputs.kernel]]

# NFS Monitoring (for hosts with NFS mounts)
{% if inventory_hostname == 'plex' %}
[[inputs.nfsclient]]
  fullstat = false
{% endif %}

# Ping monitoring to key infrastructure
[[inputs.ping]]
  urls = [
    "{{ network_data.dns_server.bind_ipv4 }}",
    "{{ network_data.dns_server.dns_ipv4 }}",
    "8.8.8.8",
    "1.1.1.1",
{% if inventory_hostname == 'vps' %}
    "{{ vps_wg_tunnel.peer_ip }}",
{% endif %}
  ]
  count = 4
  ping_interval = 1.0
  timeout = 2.0

# HTTP response check for web services
[[inputs.http_response]]
  urls = [
{% if inventory_hostname == 'adguard' %}
    "http://127.0.0.1:3000",
{% endif %}
{% if inventory_hostname == 'plex' %}
    "http://127.0.0.1:32400/web/index.html",
{% endif %}
{% if inventory_hostname == 'homepage' %}
    "http://127.0.0.1:{{ portainer_port | default(9000) }}",    # Portainer
{% endif %}
  ]
  response_timeout = "5s"
  method = "GET"
  follow_redirects = true


# Log file monitoring using tail with grok parser
[[inputs.tail]]
{% if ansible_facts['os_family'] | default('Debian') == 'Alpine' %}
  files = ["/var/log/messages"]
{% else %}
  files = ["/var/log/syslog"]
{% endif %}
  from_beginning = false
  data_format = "grok"
  grok_patterns = ["%{SYSLOGTIMESTAMP:timestamp} %{SYSLOGHOST:host} %{DATA:program}(?:\\[%{POSINT:pid}\\])?: %{GREEDYDATA:message}"]
  name_override = "syslog"

{% if inventory_hostname == 'vps' %}
# WireGuard tunnel metrics (peer handshakes, bytes transferred)
[[inputs.wireguard]]
  devices = ["wg0"]
{% endif %}
