#!/bin/bash
# {{ ansible_managed }}
# apt Proxy-Auto-Detect (ADR 0021): use the fleet package cache when it is
# reachable, otherwise print DIRECT so apt goes straight to the WAN.
#
# Not yet rendered by any task — WP2/WP4 wiring supplies apt_cache_proxy_host
# (see docs/ms01-cluster-iac-plan.md, ADR 0021 item).
# The DIRECT branch is load-bearing — first boot on a cold cutover must
# work with no cache present. Never replace this with a hard proxy setting.
if timeout 1 bash -c "exec 3<>/dev/tcp/{{ apt_cache_proxy_host }}/{{ apt_cacher_ng_port }}" 2>/dev/null; then
  echo "http://{{ apt_cache_proxy_host }}:{{ apt_cacher_ng_port }}"
else
  echo "DIRECT"
fi
