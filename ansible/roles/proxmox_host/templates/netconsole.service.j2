# {{ ansible_managed }}
# Loaded late deliberately: netconsole needs its egress interface up, and the
# bridge does not exist at early boot. Cost: pre-network boot messages are not
# captured (accepted — this lane exists for runtime disk-death capture, and a
# real boot does not replay the ring buffer). See docs/ms01-cluster-iac-plan.md WP2.
[Unit]
Description=netconsole kernel log shipping to OpenObserve
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/netconsole-start.sh
# Console loglevel 5 (err+warn pass) must be asserted HERE, not only in
# sysctl.d: systemd PID 1 captures the console level before systemd-sysctl
# runs and restores it late in boot, silently undoing the drop-in (observed
# on pve 2026-08-12: drop-in said 5, running value was 1 — netconsole shipped
# only EMERG..CRIT). Coupling it to the consumer that needs it wins the war.
ExecStartPost=/usr/bin/dmesg -n 5
ExecStop=/usr/sbin/modprobe -r netconsole

[Install]
WantedBy=multi-user.target
