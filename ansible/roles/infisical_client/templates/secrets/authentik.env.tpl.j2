# authentik secrets — rendered by Infisical Agent; keys renamed to the env names authentik and its blueprint read
{{'{{'}} with secret "{{ infisical_agent_project_id }}" "{{ infisical_agent_env_slug }}" "/authentik" {{'}}'}}
{{'{{'}}- range . {{'}}'}}
{{'{{'}}- if eq .Key "secret_key" {{'}}'}}
AUTHENTIK_SECRET_KEY={{'{{'}} .Value {{'}}'}}
{{'{{'}}- else if eq .Key "postgres_password" {{'}}'}}
AUTHENTIK_POSTGRESQL__PASSWORD={{'{{'}} .Value {{'}}'}}
POSTGRES_PASSWORD={{'{{'}} .Value {{'}}'}}
{{'{{'}}- else if eq .Key "bootstrap_password" {{'}}'}}
AUTHENTIK_BOOTSTRAP_PASSWORD={{'{{'}} .Value {{'}}'}}
{{'{{'}}- else if eq .Key "bootstrap_token" {{'}}'}}
AUTHENTIK_BOOTSTRAP_TOKEN={{'{{'}} .Value {{'}}'}}
{{'{{'}}- else if eq .Key "grafana_oidc_client_secret" {{'}}'}}
GRAFANA_OIDC_CLIENT_SECRET={{'{{'}} .Value {{'}}'}}
{{'{{'}}- else if eq .Key "portainer_oidc_client_secret" {{'}}'}}
PORTAINER_OIDC_CLIENT_SECRET={{'{{'}} .Value {{'}}'}}
{{'{{'}}- else if eq .Key "meshcentral_oidc_client_secret" {{'}}'}}
MESHCENTRAL_OIDC_CLIENT_SECRET={{'{{'}} .Value {{'}}'}}
{{'{{'}}- else if eq .Key "pdm_oidc_client_secret" {{'}}'}}
PDM_OIDC_CLIENT_SECRET={{'{{'}} .Value {{'}}'}}
{{'{{'}}- else if eq .Key "pve_oidc_client_secret" {{'}}'}}
PVE_OIDC_CLIENT_SECRET={{'{{'}} .Value {{'}}'}}
{{'{{'}}- else if eq .Key "pbs_oidc_client_secret" {{'}}'}}
PBS_OIDC_CLIENT_SECRET={{'{{'}} .Value {{'}}'}}
{{'{{'}}- else if eq .Key "synology_oidc_client_secret" {{'}}'}}
SYNOLOGY_OIDC_CLIENT_SECRET={{'{{'}} .Value {{'}}'}}
{{'{{'}}- else if eq .Key "homeassistant_oidc_client_secret" {{'}}'}}
HOMEASSISTANT_OIDC_CLIENT_SECRET={{'{{'}} .Value {{'}}'}}
{{'{{'}}- end {{'}}'}}
{{'{{'}}- end {{'}}'}}
{{'{{'}}- end {{'}}'}}
