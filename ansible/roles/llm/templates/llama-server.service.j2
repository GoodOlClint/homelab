[Unit]
Description=llama.cpp router (chat models, one loaded at a time)
After=network-online.target {{ llm_models_dir | replace('/', '-') | regex_replace('^-', '') }}.mount
Requires={{ llm_models_dir | replace('/', '-') | regex_replace('^-', '') }}.mount
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
User={{ llm_user }}
Group={{ llm_user }}
SupplementaryGroups=video render
ExecStartPre=/bin/sh -c 'vulkaninfo --summary 2>/dev/null | grep -q PHYSICAL_DEVICE_TYPE_DISCRETE_GPU'
ExecStart={{ llm_llama_cpp_dir }}/bin/llama-server \
  --host 127.0.0.1 --port {{ llm_llama_port }} \
  --models-preset /etc/llama-server/models.ini \
  --models-max {{ llm_llama_models_max }}
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
LimitCORE=0
OOMScoreAdjust=500
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths={{ llm_models_dir }}

[Install]
WantedBy=multi-user.target
