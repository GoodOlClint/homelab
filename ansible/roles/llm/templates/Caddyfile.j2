{
    auto_https off
    admin off
}
:80 {
    @api path /llama/* /pair/*
    respond @api 421
    redir https://{{ llm_fqdn }}{uri} permanent
}
:443 {
    tls {{ llm_caddy_tls_dir }}/fullchain.pem {{ llm_caddy_tls_dir }}/privkey.pem
    log {
        output stderr
        format filter {
            wrap console
            fields {
                request>headers>Authorization delete
            }
        }
    }
    @authed {
{% for c in llm_api_clients %}
        header Authorization "Bearer {env.LLM_API_KEY_{{ c | upper }}}"
{% endfor %}
    }
    handle /health {
        reverse_proxy 127.0.0.1:{{ llm_chat_port }}
    }
    handle_path /llama/* {
        @embeddings path /v1/embeddings /embeddings /embedding
        # llama-server never validates `model`: it echoes the requested name back and answers from bge-m3
        # regardless, so Caddy is the only enforcement point. An absent `model` is unambiguous and allowed.
        @wrong_embed_model expression `{http.request.body}.matches("\"model\"\\s*:\\s*\"") && !{http.request.body}.matches("\"model\"\\s*:\\s*\"{{ llm_embed_alias }}\"")`
        @model_sources {
            method POST DELETE
            path /models
        }
        handle @model_sources {
            respond 403
        }
        handle @embeddings {
            route {
                respond @wrong_embed_model `{"error":{"message":"this endpoint serves only {{ llm_embed_alias }}","type":"invalid_request_error","param":"model","code":"model_not_found"}}` 400 {
                    close
                }
                reverse_proxy @authed 127.0.0.1:{{ llm_embed_port }}
                respond 401
            }
        }
        handle {
            route {
                reverse_proxy @authed 127.0.0.1:{{ llm_chat_port }} {
                    flush_interval -1
                }
                respond 401
            }
        }
    }
    handle_path /pair/* {
        route {
{% if llm_pair_deb_url | length > 0 %}
            reverse_proxy @authed 127.0.0.1:{{ llm_pair_port }} {
                flush_interval -1
            }
            respond 401
{% else %}
            respond 503
{% endif %}
        }
    }
    handle {
        respond 404
    }
}
