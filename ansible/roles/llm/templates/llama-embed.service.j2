[Unit]
Description=llama.cpp embeddings server ({{ llm_embed_model_file }})
After=network-online.target {{ llm_models_dir | replace('/', '-') | regex_replace('^-', '') }}.mount
Requires={{ llm_models_dir | replace('/', '-') | regex_replace('^-', '') }}.mount
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
User={{ llm_user }}
Group={{ llm_user }}
SupplementaryGroups=video render
ExecStartPre=/bin/sh -c 'vulkaninfo --summary 2>/dev/null | grep -q PHYSICAL_DEVICE_TYPE_DISCRETE_GPU'
ExecStart={{ llm_llama_cpp_dir }}/bin/llama-server \
  --host 127.0.0.1 --port {{ llm_embed_port }} \
  -m {{ llm_models_dir }}/{{ llm_embed_model_file }} --alias {{ llm_embed_alias }} \
  {{ llm_embed_extra_args }}
ExecStartPost=/usr/local/bin/llama-embed-warmup
# Model load plus the pool warm-up exceeds systemd's 90 s default, and the card may be busy when it runs.
TimeoutStartSec=300
Restart=on-failure
RestartSec=10
LimitCORE=0
OOMScoreAdjust=500
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths={{ llm_models_dir }}

[Install]
WantedBy=multi-user.target
