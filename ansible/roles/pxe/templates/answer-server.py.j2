#!/usr/bin/env python3
# {{ ansible_managed }}
# PVE auto-installer answer matcher: the installer POSTs its hardware inventory
# (JSON with network_interfaces[].mac among others); we return the TOML for the
# node whose install-NIC MAC appears in it, 404 otherwise.
import json
import os
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ANSWER_DIR = "{{ pxe_answer_dir }}"
MAC_MAP = os.path.join(ANSWER_DIR, "mac-map.json")
LISTEN = ("127.0.0.1", 8080)


def load_map():
    with open(MAC_MAP) as f:
        return {k.lower(): v for k, v in json.load(f).items()}


def macs_from(payload):
    out = set()
    for iface in payload.get("network_interfaces", []) or []:
        mac = (iface.get("mac") or "").lower()
        if mac:
            out.add(mac)
    return out


def match(payload, mac_map):
    for mac in macs_from(payload):
        node = mac_map.get(mac)
        if node:
            return node
    return None


class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        if self.path.rstrip("/") != "/answer":
            return self._send(404, "not found\n")
        length = int(self.headers.get("Content-Length") or 0)
        try:
            payload = json.loads(self.rfile.read(length) or b"{}")
        except json.JSONDecodeError:
            return self._send(400, "bad json\n")
        node = match(payload, load_map())
        if not node:
            self.log_message("no answer for macs %s", sorted(macs_from(payload)))
            return self._send(404, "no answer file for this host\n")
        path = os.path.join(ANSWER_DIR, f"{node}.toml")
        if not os.path.isfile(path):
            self.log_message("node %s matched but %s missing", node, path)
            return self._send(404, "answer file missing\n")
        with open(path, "rb") as f:
            body = f.read()
        self.log_message("served answer for %s", node)
        self._send(200, body, "text/plain")

    def do_GET(self):
        self._send(405, "POST only\n")

    def _send(self, code, body, ctype="text/plain"):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def _selfcheck():
    known, other = ":".join(["ab"] * 6), ":".join(["01"] * 6)
    m = {known: "n1"}
    assert match({"network_interfaces": [{"mac": known.upper()}]}, m) == "n1"
    assert match({"network_interfaces": [{"mac": other}]}, m) is None
    assert match({}, m) is None
    print("selfcheck ok")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--selfcheck":
        _selfcheck()
        sys.exit(0)
    ThreadingHTTPServer(LISTEN, Handler).serve_forever()
