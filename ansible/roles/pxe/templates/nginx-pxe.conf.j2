# {{ ansible_managed }}
server {
    listen 80 default_server;
    server_name _;
    root {{ pxe_http_dir }};
    autoindex off;
    access_log /var/log/nginx/pxe.access.log;

    location /answer {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        client_max_body_size 1m;
    }
}
