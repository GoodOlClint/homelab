# Style-only rules are skipped; everything else that was open on 2026-09-10 is baselined in
# .ansible-lint-ignore (issue #5). A new violation fails CI; drain the baseline in later tranches.
profile: production
skip_list:
  - var-naming[no-role-prefix]
  - name[casing]
  - name[missing]
  - name[template]
  - run-once[task]
  - key-order[task]
  - jinja[spacing]
  - yaml[line-length]
exclude_paths:
  - roles/geerlingguy.docker/
  - roles/mitre.yedit/
  - roles/juju4.openobserve/
  - roles/plex_services/
  - inventory/
  # Retired-guest roles, deleted by the audit's retired-guest sweep (#24); not worth polishing
  - roles/nvidia/
  - roles/nvidia_licensing/
  - roles/squid/
  - roles/minio/
  # Shared task files are included as "{{ playbook_dir }}/../tasks/<file>", which the linter cannot
  # template, so it looks for them under the including role and reports a phantom load-failure
  - roles/*/tasks/generate_secret.yml
  - roles/*/tasks/infisical_write_secret.yml
  - roles/*/tasks/configure_docker_logging.yml
  - roles/*/tasks/api_certificate.yml
  - roles/*/tasks/configure_pbs_backup.yml
kinds:
  - playbook: playbooks/*.yml
  - tasks: tasks/*.yml
