# Style-only rules are skipped; no ignore file — a new violation fails CI (issue #5).
profile: production
skip_list:
  - var-naming[no-role-prefix]
  - name[casing]
  - name[missing]
  - name[template]
  - run-once[task]
  - key-order[task]
  - jinja[spacing]
  - yaml[line-length]
exclude_paths:
  - roles/geerlingguy.docker/
  - inventory/
  # Shared task files are included as "{{ playbook_dir }}/../tasks/<file>", which the linter cannot
  # template, so it looks for them under the including role and reports a phantom load-failure
  - roles/*/tasks/generate_secret.yml
  - roles/*/tasks/infisical_write_secret.yml
  - roles/*/tasks/infisical_admin_token.yml
  - roles/*/tasks/configure_docker_logging.yml
  - roles/*/tasks/api_certificate.yml
  - roles/*/tasks/configure_pbs_backup.yml
  - roles/*/tasks/proxmox_apt_repo.yml
kinds:
  - playbook: playbooks/*.yml
  - tasks: tasks/*.yml
