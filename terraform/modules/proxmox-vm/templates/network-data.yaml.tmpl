#cloud-config
version: 2
ethernets:
%{ for iface in interfaces ~}
  ${iface.name}:
    match:
      macaddress: '${iface.macaddress}'
    set-name: ${iface.name}
    mtu: ${iface.mtu}
    dhcp4: ${iface.dhcp}
%{ if iface.dhcp ~}
    dhcp4-overrides:
%{ if iface.is_gateway || iface.is_primary ~}
      route-metric: 100
%{ else ~}
      route-metric: 200
      use-routes: false
%{ endif ~}
%{ endif ~}
%{ if iface.accept_ra ~}
    accept-ra: true
%{ else ~}
    accept-ra: false
%{ endif ~}
%{ if iface.dhcp6 ~}
    dhcp6: true
%{ else ~}
    dhcp6: false
%{ endif ~}
%{ if !iface.dhcp && iface.address != "" || iface.address_v6 != "" }
    addresses:
%{ if !iface.dhcp && iface.address != "" ~}
      - ${iface.address}/${iface.prefix}
%{ endif ~}
%{ if iface.address_v6 != "" ~}
      - ${iface.address_v6}/${iface.prefix_v6}
%{ endif ~}
%{ endif }
%{ if !iface.dhcp && iface.gateway != "" }
    routes:
      # Every static leg gets its own table (connected + default) and a /32 source
      # rule below — INCLUDING the gateway leg. Without it, traffic sourced from the
      # gateway leg's address falls through to main, where the OTHER legs' connected
      # routes live, and a reply to a host on a sibling VLAN leaves via that sibling
      # interface with the wrong source address: asymmetric through pfSense (TCP
      # dies out-of-state) and the switch reports the IP behind two MACs.
      - to: ${iface.subnet}
        scope: link
        table: ${iface.routing_table}
      - to: default
        via: ${iface.gateway}
        table: ${iface.routing_table}
%{ if iface.is_gateway ~}
      - to: default
        via: ${iface.gateway}
%{ endif ~}
%{ if iface.gateway_v6 != "" }
      - to: "::/0"
        via: ${iface.gateway_v6}
        table: ${iface.routing_table}
%{ if iface.is_gateway ~}
      - to: "::/0"
        via: ${iface.gateway_v6}
%{ endif ~}
%{ endif }
    routing-policy:
      # /32, NOT the interface prefix. This rule exists to send traffic ORIGINATING
      # from this host's own address out the matching interface. Using /${iface.prefix}
      # makes it match every source in the subnet, including *remote* hosts — so any
      # forwarded packet (e.g. a reply to a Docker container) whose source is a
      # neighbour on this VLAN gets looked up in the per-VLAN table, which has no route
      # to the bridge, and is sent back out the gateway instead of to the container.
      # Symptom: containers can reach the internet and other VLANs fine, but every
      # connection to a host on THIS interface's subnet hangs with the SYN-ACK arriving
      # and never being reverse-NATed.
      - from: ${iface.address}/32
        table: ${iface.routing_table}
%{ endif }
%{ if length(iface.dns_servers) > 0 }
    nameservers:
      addresses:
%{ for dns in iface.dns_servers ~}
        - ${dns}
%{ endfor ~}
%{ endif }
%{ endfor }
