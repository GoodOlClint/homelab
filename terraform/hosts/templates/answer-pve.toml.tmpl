# proxmox-auto-install answer file — pve node (rebuilt MSI, Ceph node 3 + GPU/LLM host).
# TEMPLATE: @PLACEHOLDERS@ injected by scripts/bake-answer.sh at ISO-bake time.
# Validate the baked file with `proxmox-auto-install-assistant validate-answer <file>`.
#
# Disk layout (default, 2026-07): pve has dedicated boot disks, so NO hdsize cap —
#   boot  = ZFS mirror on the 2x Samsung 980 PRO 500G
#   Ceph  = the 2x Samsung 990 PRO 2TB, whole-disk OSDs (WP2)
#   the 5T Synology iSCSI SAN (sda) is RETIRED (ADR-0001: NAS = media/PBS/ISO only)
# Boot disks are selected by MODEL (@BOOT_DISK_MODEL@, binding boot_disk_model):
# NVMe enumeration shifts between boots, and the 2TB OSD disks must never be picked.
#
# NIC: pve installs over the I225-V (single 2.5G, VLAN 30). Its 10G bond is the
# 82599ES SFP+ pair (managed post-install by terraform/hosts). Seat the 25G card
# BEFORE installing so the ConnectX ports get pinned to nicN too.

[global]
keyboard             = "en-us"
country              = "us"
timezone             = "America/Chicago"
fqdn                 = "@FQDN@"
mailto               = "@MAILTO@"
root-password-hashed = "@ROOT_PW_HASH@"
root-ssh-keys        = ["@ROOT_SSH_KEY@"]

[network]
source                 = "from-answer"
cidr                   = "@INSTALL_CIDR@"    # VLAN 30 mgmt CIDR
gateway                = "@INSTALL_GATEWAY@" # VLAN 30 gateway
dns                    = "1.1.1.1"
filter.ID_NET_NAME_MAC = "*@INSTALL_NIC_MAC@" # I225-V MAC, no colons

[disk-setup]
filesystem = "zfs"
zfs.raid   = "raid1"
filter.ID_MODEL = "@BOOT_DISK_MODEL@"   # the 500G boot pair, whole-disk mirror; never the 2TB OSD disks

# First boot: pin nicN names + quiet console + reboot — served by the pxe guest
# (ADR 0026). bake-answer.sh drops this section when no pxe_url binding is set
# (ISO/IDE-R fallback installs then need `pve-network-interface-pinning generate` by hand).
[first-boot]
source   = "from-url"
url      = "@PXE_URL@/first-boot.sh"
ordering = "fully-up"
